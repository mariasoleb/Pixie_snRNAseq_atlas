compare_celltype <- function(target_cell) {

  df_tmp <- df_pb %>%
    mutate(CellGroup = factor(ifelse(CellType == target_cell, target_cell, "Other"),
                              levels = c("Other", target_cell)))

  results <- map_dfr(regulon_cols_safe, function(reg) {

    # Wrap the column name in backticks
    fit <- lm(as.formula(paste0("`", reg, "` ~ CellGroup + Organ")), data = df_tmp)
    coef_tab <- summary(fit)$coefficients

    # Find the coefficient corresponding to CellGroup (target vs Other)
    target_row <- grep(paste0("^CellGroup", target_cell, "$"), rownames(coef_tab))
    
    if(length(target_row) == 1) {
      effect <- coef_tab[target_row, "Estimate"]
      pval   <- coef_tab[target_row, "Pr(>|t|)"]
    } else {
      effect <- NA
      pval <- NA
    }

    tibble(
      regulon = gsub("___", "::", reg),
      target_cell = target_cell,
      effect = effect,
      pval = pval
    )
  })

  results <- results %>% mutate(padj = p.adjust(pval, method = "BH"))
  return(results)
}

