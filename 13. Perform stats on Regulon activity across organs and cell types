# Threshold for significance
sig_thresh <- -log10(0.00000001)

# Function to create volcano plot for a cell type
make_volcano <- function(df, cell_name, title_name) {
  
  df <- df %>%
    mutate(
      logpadj = -log10(padj),
      sig = logpadj > sig_thresh  # TRUE if above threshold
    )
  
  ggplot(df, aes(x = effect, y = logpadj)) +
    geom_point(aes(color = sig), alpha = 0.6) +
    scale_color_manual(values = c("FALSE" = "steelblue", "TRUE" = "red")) +
    
    # vertical and horizontal dashed lines
    geom_vline(xintercept = 0, linetype = "dashed", color = "grey50") +
    geom_hline(yintercept = sig_thresh, linetype = "dashed", color = "red") +
    
    # label for the dashed line
    annotate("text", x = min(df$effect, na.rm = TRUE), 
             y = sig_thresh + 0.5, 
             label = "p < 1e-8", 
             color = "red", hjust = 0, size = 4) +
    
    theme_minimal(base_size = 14) +
    labs(
      title = paste0(title_name, ": Regulon Activity Volcano Plot"),
      x = paste0("Effect size (", cell_name, " vs Other)"),
      y = "-log10(adjusted p-value)"
    ) +
    
    # remove legend
    theme(
      plot.title = element_text(hjust = 0.5),
      legend.position = "none"
    )
}

