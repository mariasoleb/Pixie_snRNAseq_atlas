compare_organ <- function(target_organ) {

  df_tmp <- df_pb %>%
    mutate(OrganGroup = factor(ifelse(Organ == target_organ, target_organ, "Other"),
                               levels = c("Other", target_organ)))

  results <- map_dfr(regulon_cols_safe, function(reg) {

    fit <- lm(as.formula(paste0("`", reg, "` ~ OrganGroup + CellType")), data = df_tmp)
    coef_tab <- summary(fit)$coefficients

    # Find coefficient row
    target_row <- grep(paste0("^OrganGroup", target_organ, "$"), rownames(coef_tab))

    if(length(target_row) == 1) {
      effect <- coef_tab[target_row, "Estimate"]
      pval   <- coef_tab[target_row, "Pr(>|t|)"]
    } else {
      effect <- NA
      pval <- NA
    }

    tibble(
      regulon = gsub("___", "::", reg),
      target_organ = target_organ,
      effect = effect,
      pval = pval
    )
  })

  results <- results %>%
    mutate(padj = p.adjust(pval, method = "BH"))

  return(results)
}



