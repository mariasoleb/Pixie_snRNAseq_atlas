pdf("./plots_alevin/Allregulons_AllOrgans_activity.pdf", width = 16, height = 16)

Heatmap(
  mat,                       # your full regulon activity matrix
  name = "Regulon activity",
  top_annotation = ha,        # attach your column annotation
  cluster_rows = TRUE,
  cluster_columns = TRUE,
  show_row_names = FALSE,     # hide row labels (2000+ rows)
  show_column_names = TRUE,   # or FALSE if too many columns
  row_title = "Regulons",
