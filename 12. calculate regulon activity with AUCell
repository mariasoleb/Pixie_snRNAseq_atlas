seurat_obj <- readRDS("./alevin_seurat_clean/AllTissues_SCT.rds")

# expression matrix
expr <- GetAssayData(seurat_obj, slot = "data")

# filter genes
expr <- expr[rowSums(expr > 0) > 10, ]

# rankings
rankings <- AUCell_buildRankings(expr)

# compute AUC for ALL regulons
cells_auc <- AUCell_calcAUC(all_regulons, rankings)

auc_matrix <- getAUC(cells_auc)

# clean names
rownames(auc_matrix) <- gsub("_", "-", rownames(auc_matrix))

seurat_obj[["RegulonActivity"]] <- CreateAssayObject(data = auc_matrix)

DefaultAssay(seurat_obj) <- "RegulonActivity"

seurat_obj$organ_celltype <- paste(
  seurat_obj$Tissue_Group,
  seurat_obj$cluster_annotation,
  sep = "__"
)

Idents(seurat_obj) <- "organ_celltype"

avg_reg <- AverageExpression(
  seurat_obj,
  assays = "RegulonActivity"
)$RegulonActivity

# variability
var_reg <- apply(avg_reg, 1, var)

top_reg <- names(sort(var_reg, decreasing = TRUE))[1:20]

heatmap_matrix <- avg_reg[top_reg, ]

# scale
heatmap_matrix <- t(scale(t(heatmap_matrix)))


library(ComplexHeatmap)

pdf("./plots_alevin/Allregulons_AllOrgans_activity.pdf", width=10, height=10)

Heatmap(
  heatmap_matrix,
  name = "Regulon activity",
  cluster_rows = TRUE,
  cluster_columns = TRUE,
  show_row_names = TRUE
)

dev.off()

write.csv(heatmap_matrix, "./output_dir/AllRegulons_AllOrgans_activity.csv")

saveRDS(seurat_obj, "./alevin_seurat_clean/AllTissues_AllRegulons.rds")


