rownames(col_annot) <- colnames(mat)


library(ComplexHeatmap)
library(circlize)

organ_colors <- setNames(
  rainbow(length(unique(col_annot$Organ))),
  unique(col_annot$Organ)
)

celltype_colors <- structure(
  colorRampPalette(c("grey20","lightblue"))(length(unique(col_annot$CellType))),
  names = unique(col_annot$CellType)
)

ha <- HeatmapAnnotation(
  Organ = col_annot$Organ,
  CellType = col_annot$CellType,
  col = list(
    Organ = organ_colors,
    CellType = celltype_colors
  )
)

library(ComplexHeatmap)
