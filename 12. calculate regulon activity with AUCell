
library(dplyr)
library(AUCell)
library(Seurat)

# folder with regulons
regulon_dir <- "regulons_list/"

files <- list.files(regulon_dir, full.names = TRUE)

# function to read one regulon file
read_regulons <- function(file) {
  
  organ <- gsub("_regulons.tsv", "", basename(file))
  
  reg <- read.delim(file, header = FALSE)
  colnames(reg) <- c("TF","cluster","targets")
  
  regulons <- lapply(1:nrow(reg), function(i) {
    strsplit(reg$targets[i], ",")[[1]]
  })
  
  # IMPORTANT: add organ prefix
  names(regulons) <- paste0(
    organ, "::", reg$TF, "-", reg$cluster
  )
  
  return(regulons)
}

# read all and merge
regulons_list <- lapply(files, read_regulons)

# flatten into one list
all_regulons <- unlist(regulons_list, recursive = FALSE)

# ensure unique names
names(all_regulons) <- make.unique(names(all_regulons))

