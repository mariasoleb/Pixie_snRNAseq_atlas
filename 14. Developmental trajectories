# Developmental Trajectories

## Goal

Refine cluster annotations with developmental stage labels and reconstruct pseudotime trajectories using Monocle3 for berry exocarp, berry mesocarp, leaf epidermis, leaf mesophyll, and flower pollen cell types.

```r
library(monocle3)
#library(SeuratWrappers)
library(Seurat)
library(ggplot2)
library(tidyverse)
library(plyr)


seurat_obj<-readRDS("./alevin_seurat_clean/Berry_SCT_Ann_noChl_simpler.rds")

new.cluster.ids <- c(
  "0" = "Vascular_Parenchyma",
  "1" = "Green_Exocarp",
  "2" = "Ripening_Mesocarp",
  "3" = "Green_Mesocarp",
  "4" = "Mature_Exocarp",
  "5" = "Mature_Mesocarp",
  "6" = "Epidermis",
  "7" = "Green_Mesocarp",
  "8" = "Ripening_Exocarp",
   "9" = "Xylem_Parenchyma",
  "10" = "Phloem_Parenchyma",
  "11" = "Vascular_Parenchyma",
  "12" = "Ripening_Exocarp",
  "13" = "Green_Exocarp",
  "14" = "Ripening_Exocarp",
  "15" = "Companion_Cell"
)
#- Bogs et al., 2006, _Plant Physiology_, "Flavonoid pathway gene expression in grape berry skin and pulp."

#- Castellarin et al., 2007, _Plant Physiology_, showing **skin-specific upregulation of CHS during veraison**.

seurat_obj$refined_cluster <- mapvalues(
  seurat_obj$SCT_snn_res.1,
  from = names(new.cluster.ids),
  to = new.cluster.ids
)

Idents(seurat_obj) <- seurat_obj$refined_cluster


p1<- DimPlot(seurat_obj, reduction = 'umap', group.by = 'refined_cluster', label=T)

p2<- DimPlot(seurat_obj, reduction = 'umap', group.by = 'cluster_annotation', label=T)

p3<- DimPlot(seurat_obj, reduction = 'umap', group.by = 'Tissue_Rep', label=T)

pdf("./plots_alevin/berry_UMAP_refinedClusters.pdf", width=10, height=5)
p1|p2
dev.off()

